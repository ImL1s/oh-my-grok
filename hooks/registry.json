{
  "schema": "omg-hooks-registry/v1",
  "kind": "read_only_machine_registry",
  "note": "Host-neutral lifecycle registry (#72 first cut). Grok PreToolUse/Stop are the only blocking host hooks (Stop pin grok >=0.2.107, cap 8/turn, fail-open). SessionStart/SubagentStop are passive (stdout ignored). UserPromptSubmit is eligible_unclaimed and MUST NOT inject. Antigravity files are projections, not live AG evidence. Kill switches: DISABLE_OMG / OMG_DISABLE_HOOKS / OMG_SKIP_HOOKS. Does not set verified.",
  "canonical_events": [
    "prompt.submit",
    "session.start",
    "session.end",
    "tool.pre",
    "tool.post",
    "tool.failure",
    "permission.request",
    "subagent.start",
    "subagent.stop",
    "compact.pre",
    "idle",
    "stop.request",
    "workflow.transition",
    "artifact.created",
    "job.terminal",
    "team.member.transition"
  ],
  "hooks": [
    {
      "id": "omg.pretool.deny",
      "event": "tool.pre",
      "runtime_projection": "grok",
      "host_hook": "PreToolUse",
      "host_capability": "native_blocking",
      "priority": 10,
      "timeout_ms": 5000,
      "fail_policy": "fail-open",
      "enabled": true,
      "required_capabilities": [],
      "privacy_class": "security",
      "handler": "deny.decide_pre_tool_use",
      "note": "Existing soft-gate; fail-open; not a sandbox. Host honors PreToolUse."
    },
    {
      "id": "omg.stop.gate",
      "event": "stop.request",
      "runtime_projection": "grok",
      "host_hook": "Stop",
      "host_capability": "native_blocking",
      "priority": 10,
      "timeout_ms": 120000,
      "fail_policy": "fail-open",
      "enabled": true,
      "required_capabilities": [],
      "privacy_class": "workflow",
      "handler": "stop_gate.decide_stop",
      "note": "Honored grok >=0.2.107; cap 8/turn; fail-open. Not infinite OMC stickiness."
    },
    {
      "id": "omg.session.start.observe",
      "event": "session.start",
      "runtime_projection": "grok",
      "host_hook": "SessionStart",
      "host_capability": "native_passive",
      "priority": 50,
      "timeout_ms": 10000,
      "fail_policy": "fail-open",
      "enabled": true,
      "required_capabilities": [],
      "privacy_class": "observability",
      "handler": "observe",
      "note": "Stdout ignored by Grok. May passively refresh RESUME.md. Never verifies."
    },
    {
      "id": "omg.subagent.stop.observe",
      "event": "subagent.stop",
      "runtime_projection": "grok",
      "host_hook": "SubagentStop",
      "host_capability": "native_passive",
      "priority": 50,
      "timeout_ms": 10000,
      "fail_policy": "fail-open",
      "enabled": true,
      "required_capabilities": [],
      "privacy_class": "observability",
      "handler": "observe",
      "note": "Passive. Must not emit decision:block."
    },
    {
      "id": "omg.prompt.submit.unsupported",
      "event": "prompt.submit",
      "runtime_projection": "grok",
      "host_hook": "UserPromptSubmit",
      "host_capability": "unsupported",
      "priority": 90,
      "timeout_ms": 1,
      "fail_policy": "fail-open",
      "enabled": false,
      "required_capabilities": [],
      "privacy_class": "routing",
      "handler": "unsupported",
      "note": "Grok stdout ignored; OMG must not invent UserPromptSubmit injection. Routing lives in ~/.grok/rules/omg.md."
    },
    {
      "id": "omg.compact.handoff",
      "event": "compact.pre",
      "runtime_projection": "omg-cli",
      "host_hook": null,
      "host_capability": "wrapper",
      "priority": 20,
      "timeout_ms": 5000,
      "fail_policy": "fail-open",
      "enabled": true,
      "required_capabilities": [],
      "privacy_class": "handoff",
      "handler": "compact_handoff",
      "note": "Bounded ids-only artifact. Never copies the transcript. Grok PreCompact is unavailable."
    },
    {
      "id": "omg.continuation.guard",
      "event": "workflow.transition",
      "runtime_projection": "omg-cli",
      "host_hook": null,
      "host_capability": "reconciled",
      "priority": 15,
      "timeout_ms": 1000,
      "fail_policy": "fail-closed",
      "enabled": true,
      "required_capabilities": [],
      "privacy_class": "workflow",
      "handler": "continuation_guard",
      "note": "Exactly one continuation owner. refuse/adopt_existing/artifact_only. Never sets verified."
    }
  ]
}
